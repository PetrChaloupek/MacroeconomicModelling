# potřebné balíčky
library(readr)     # pro čtení csv
library(openxlsx)  # pro export do Excelu
# 1. Import .csv souboru
df <- read_csv("GBP:EUR.csv", col_names = FALSE)
# 2. Přejmenuj sloupce
colnames(df) <- c("Date1", "Date2", "ZL/EUR")
# 3. Vezmi jen vektor "ZL/EUR"
