output$plot11 <- renderPlot({
# Cyhyb predikci
mse_diff <- mean(forecast_errors_diff^2, na.rm = TRUE)
mae_diff <- mean(abs(forecast_errors_diff), na.rm = TRUE)
mse_gap <- mean(forecast_errors_gap^2, na.rm = TRUE)
mae_gap <- mean(abs(forecast_errors_gap), na.rm = TRUE)
better_mse_model <- if (mse_diff < mse_gap) "Diff VAR" else "Gap VAR"
better_mae_model <- if (mae_diff < mae_gap) "Diff VAR" else "Gap VAR"
sd_actual_diff <- sd(actual_diff, na.rm = TRUE)
rel_error_diff <- mae_diff / sd_actual_diff
sd_actual_gap <- sd(actual_gap, na.rm = TRUE)
rel_error_gap <- mae_gap / sd_actual_gap
# Vytvoření grafu pro zobrazení chyb predikcí
errors_df <- data.frame(
Model = c("Diff VAR", "Gap VAR"),
MSE = c(mse_diff, mse_gap),
MAE = c(mae_diff, mae_gap),
Rel_Error = c(rel_error_diff, rel_error_gap)
)
errors_plot <- ggplot(errors_df, aes(x = Model)) +
geom_bar(aes(y = MSE, fill = "MSE"), stat = "identity", position = "dodge") +
geom_bar(aes(y = MAE, fill = "MAE"), stat = "identity", position = "dodge") +
geom_bar(aes(y = Rel_Error, fill = "Rel_Error"), stat = "identity", position = "dodge") +
scale_fill_manual(values = c("MSE" = "#670A20", "MAE" = "#D6614D", "Rel_Error" = "#2166AD")) +
labs(
title = "Chyby predikcí modelů",
x = "Model",
y = "Hodnota",
fill = "Metrika",
caption = "Zdroj: vlastní výpočty"
) +
theme_minimal(base_size = 14) +
theme(
plot.title = element_text(face = "bold", hjust = 0.5),
legend.position = "bottom",
legend.text = element_text(size = 12),
plot.caption = element_text(hjust = 0, face = "italic", size = 10)
)
errors_plot
})
}
# Spuštění Shiny aplikace
shinyApp(ui = ui, server = server)
