# Definice uživatelského rozhraní
ui <- fluidPage(
titlePanel("Hybatelé českého exportu"),
sidebarLayout(
sidebarPanel(
# Přidejte vstupní prvky zde
dateRangeInput("dateRange", "Vyberte rozsah dat:",
start = as.Date("2005-01-01"),
end = as.Date("2023-07-01"),
min = as.Date("2005-01-01"),
max = as.Date("2023-07-01"))
),
mainPanel(
# Přidejte výstupní prvky zde
plotOutput("plot1"),
plotOutput("plot2"),
plotOutput("plot3"),
plotOutput("plot4"),
plotOutput("plot5"),
plotOutput("plot6"),
plotOutput("plot7"),
plotOutput("plot8"),
plotOutput("plot9"),
plotOutput("plot10"),
plotOutput("plot11")
)
)
)
# Definice serverové logiky
server <- function(input, output) {
# Načtení dat
data <- reactive({
HDPger <- fredr(
series_id = "CLVMNACSCAB1GQDE",
observation_start = input$dateRange[1],
observation_end = input$dateRange[2],
frequency = "q"
)
HDPfr <- fredr(
series_id = "CLVMNACSCAB1GQFR",
observation_start = input$dateRange[1],
observation_end = input$dateRange[2],
frequency = "q"
)
HDPit <- fredr(
series_id = "CLVMNACSCAB1GQIT",
observation_start = input$dateRange[1],
observation_end = input$dateRange[2],
frequency = "q"
)
HDPau <- fredr(
series_id = "CLVMNACSCAB1GQAT",
observation_start = input$dateRange[1],
observation_end = input$dateRange[2],
frequency = "q"
)
HDPsp <- fredr(
series_id = "CLVMNACSCAB1GQES",
observation_start = input$dateRange[1],
observation_end = input$dateRange[2],
frequency = "q"
)
REER <- fredr(
series_id = "RBCZBIS",
observation_start = input$dateRange[1],
observation_end = input$dateRange[2],
frequency = "q"
)
Export <- fredr(
series_id = "NAEXKP06CZQ652S",
observation_start = input$dateRange[1],
observation_end = input$dateRange[2],
frequency = "q"
)
y_ger <- dplyr::select(HDPger, date, HDPger = value)
y_fr <- dplyr::select(HDPfr, date, HDPfr = value)
y_it <- dplyr::select(HDPit, date, HDPit = value)
y_au <- dplyr::select(HDPau, date, HDPau = value)
y_sp <- dplyr::select(HDPsp, date, HDPsp = value)
reer <- dplyr::select(REER, date, REER = value)
ex <- dplyr::select(Export, date, Export = value)
data <- y_ger %>%
left_join(y_fr, by = "date") %>%
left_join(y_it, by = "date") %>%
left_join(y_au, by = "date") %>%
left_join(y_sp, by = "date") %>%
left_join(reer, by = "date") %>%
left_join(ex, by = "date")
data$eurozona <- 0.63 * data$HDPger + 0.11 * data$HDPfr + 0.10 * data$HDPit +
0.09 * data$HDPau + 0.07 * data$HDPsp
data <- data %>%
mutate(Export = ((Export / 26)/1000000))
data
})
# Vykreslení všech proměnných
output$plot1 <- renderPlot({
data_long <- data() %>%
pivot_longer(
cols = -date,
names_to = "variable",
values_to = "value"
)
CARA2 <- data_long %>%
ggplot(aes(x = date, y = value, color = variable)) +
geom_line(size = 1.2) +
facet_wrap(~variable, nrow = 4, ncol = 2, scales = "free_y") +
scale_color_brewer(palette = "RdBu") +
scale_x_date(date_breaks = "5 year", date_labels = "%Y", expand = c(0, 0)) +
scale_y_continuous(labels = scales::comma) +
theme_minimal(base_size = 14) +
theme(
plot.title = element_text(face = "bold", hjust = 0.5),
legend.position = "none",
strip.text = element_text(face = "bold")
) +
labs(
title = "Časové řady",
x = "Datum",
y = "Hodnota",
caption = "Zdroj: FRED, vlastní výpočty"
)  +
theme(
plot.title = element_text(face = "bold", hjust = 0.5),
legend.position = "none",
strip.text = element_text(face = "bold"),
plot.caption = element_text(hjust = 0, face = "italic", size = 10)
)
CARA2
})
# Přidejte další výstupní prvky zde podle potřeby
