)
# Přidání aktuálního bodu
fig <- fig %>% add_trace(
x = input$outputGap,
y = input$currentInflation,
type = "scatter",
mode = "markers",
marker = list(color = "red", size = 10, symbol = "circle"),
name = "Aktuální pozice",
